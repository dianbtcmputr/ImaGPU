{
  "sizer": "ig_OutSize = ig_InSize;",
  "pixer": "// ----- \u8fb9\u7f18\u63d0\u53d6 (Sobel) -----\n// 1. \u83b7\u53d6\u90bb\u57df\u50cf\u7d20\u5e76\u8f6c\u4e3a\u7070\u5ea6\nvec4 center = igGetPix(ig_Position);\nfloat gray_center = dot(center.rgb, vec3(0.299, 0.587, 0.114));\n\nfloat tl = dot(igGetPix(ig_Position + ivec2(-1, 1)).rgb, vec3(0.299, 0.587, 0.114));\nfloat tc = dot(igGetPix(ig_Position + ivec2(0, 1)).rgb, vec3(0.299, 0.587, 0.114));\nfloat tr = dot(igGetPix(ig_Position + ivec2(1, 1)).rgb, vec3(0.299, 0.587, 0.114));\nfloat ml = dot(igGetPix(ig_Position + ivec2(-1, 0)).rgb, vec3(0.299, 0.587, 0.114));\nfloat mr = dot(igGetPix(ig_Position + ivec2(1, 0)).rgb, vec3(0.299, 0.587, 0.114));\nfloat bl = dot(igGetPix(ig_Position + ivec2(-1, -1)).rgb, vec3(0.299, 0.587, 0.114));\nfloat bc = dot(igGetPix(ig_Position + ivec2(0, -1)).rgb, vec3(0.299, 0.587, 0.114));\nfloat br = dot(igGetPix(ig_Position + ivec2(1, -1)).rgb, vec3(0.299, 0.587, 0.114));\n\n// 2. Sobel \u5377\u79ef\u8ba1\u7b97\nfloat Gx = (tl + 2.0 * ml + bl) - (tr + 2.0 * mr + br);\nfloat Gy = (tl + 2.0 * tc + tr) - (bl + 2.0 * bc + br);\n\n// 3. \u68af\u5ea6\u5e45\u503c\uff08\u6b27\u51e0\u91cc\u5f97\u8ddd\u79bb\uff09\uff0c\u5f52\u4e00\u5316\u5230 0~1\nfloat mag = length(vec2(Gx, Gy));\nfloat edge = clamp(mag * 2, 0.0, 1.0);\n\n// 4. \u8f93\u51fa\u7070\u5ea6\u8fb9\u7f18\u56fe\uff0c\u4fdd\u7559\u539f Alpha\nig_PixColor = vec4(edge, edge, edge, center.a);",
  "params": {
    "no_use": [
      0,
      [
        1.0,
        0.0,
        0.0,
        0.0
      ]
    ]
  },
  "boundary": [
    "Clamp",
    "Repeat"
  ]
}